{
    "email": "^[a-z0-9]+(?:[._][a-z0-9]+)*\\@[a-z]+(?:\\.[a-z]+)+$",
    "http_status_message": "^\\d{3}( [a-zA-Z]+)+$",
    "snils": "^\\d{11}$",
    "passport" : "^\\d{2}\\s\\d{2}\\s\\d{6}$",
    "ip_v4": "^((25[0-5]|(2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))\\.){3}(25[0-5]|(2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))$",
    "longitude": "^-?(180(\\.0+)?|1[0-7]\\d(\\.\\d+)?|[1-9]?\\d(\\.\\d+)?)$",
    "hex_color": "^\\#[0-9a-fA-F]{6}$",
    "isbn": "^\\d+-\\d+-\\d+-\\d+(:?-\\d+)?$",
    "locale_code": "^[a-z]{2}(-[a-z]{2})?$",
    "time" : "([01]\\d|2[0-3]):([0-5]\\d):([0-5]\\d)\\.(\\d{1,6})"
}